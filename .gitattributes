* text=auto
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
*.png binary
# Audited report snapshots must keep the exact bytes used by SHA-256 receipts.
benchmarks/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
benchmarks/results/mvp-*/**/build.log -whitespace
benchmarks/results/mvp-*/executed-source/** -whitespace
# Frozen R106 split-language snapshots and the retained failed process log.
benchmarks/results/mvp-r106-v1/java/executed-source/** -whitespace
benchmarks/results/mvp-r106-v1/javascript/executed-source/** -whitespace
benchmarks/results/mvp-r106-container-v1/smoke-host.log -whitespace
benchmarks/references/** -text -whitespace
benchmarks/corpus-inputs/** -text -whitespace
benchmarks/manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
