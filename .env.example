SBOM_API_TOKEN_FILE=/run/secrets/api-token
SBOM_BITBUCKET_HOSTS=bitbucket.org
SBOM_BITBUCKET_AUTH_MODE=basic
SBOM_BITBUCKET_TOKEN_FILE=/run/secrets/bitbucket-token
SBOM_REGISTRY_HOSTS=registry.example.com
SBOM_REGISTRY_USERNAME=
SBOM_REGISTRY_PASSWORD_FILE=/run/secrets/registry-password
SBOM_IMAGE_PLATFORM=linux/amd64
SBOM_WORKERS=1
SBOM_TRIVY_CACHE_DIR=/workspace/trivy-cache
SBOM_IMAGE_TEMP_DIR=/workspace/image-cache
SBOM_JAVA_IMAGE_EVIDENCE=true
# Used only when archive components are explicitly disabled; legacy nested selector.
SBOM_JAVA_NESTED_WINDOWS=false
# Default delivered-JAR proof; class/resource payload remains a separate fact.
# Explicit false restores the older payload-only reader.
SBOM_JAVA_ARCHIVE_COMPONENTS=true
SBOM_JAVA_BACKEND=disabled
